# Copy to .env and adjust.

# Base URL of the backend API, used by the browser.
# Leave empty in development: the app calls /api/v1 and the Vite dev server forwards it (see API_PROXY_TARGET).
# Set it for production builds, e.g. https://fc-backend.example.com/api/v1
VITE_API_URL=

# Where the Vite dev server forwards /api requests. Defaults to http://localhost:3000.
API_PROXY_TARGET=
